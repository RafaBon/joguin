* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    background-color: #70c5ce;
}

#game-container {
    position: relative;
    width: 1280px;
    height: 720px;
    background-color: #70c5ce;
    overflow: hidden;
}

#game-canvas {
    width: 100%;
    height: 100%;
}
